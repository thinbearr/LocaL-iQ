# LocaL-iQ Environment Variables Template

# Google Gemini API Key (Required for answer generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Variant (Optional, defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# ChromaDB Storage Directory (Optional, defaults to ./chroma_db)
CHROMA_DB_DIR=./chroma_db

# Embedding Provider: 'gemini' (0MB local RAM for Render cloud deployment) or 'local' (sentence-transformers for desktop)
EMBEDDING_PROVIDER=gemini

# Frontend Backend REST API Target URL
VITE_API_URL=http://127.0.0.1:5000
